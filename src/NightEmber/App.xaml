<Application x:Class="NightEmber.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="MinWidth" Value="82" />
        </Style>
        <Style x:Key="SpinnerButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="70" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SpinnerArrowStyle" TargetType="{x:Type Path}">
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="4" />
        </Style>
    </Application.Resources>
</Application>
