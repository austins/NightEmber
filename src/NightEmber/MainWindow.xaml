<Window x:Class="NightEmber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NightEmber.Controls"
        Title="Night Ember"
        Width="500"
        Height="780"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/AppIcon.ico"
        FocusManager.FocusedElement="{Binding ElementName=StrengthSlider}"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="InputErrorTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Focusable="False" IsTabStop="False">
            <Grid Margin="28,22,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
                    <Viewbox Width="44"
                             Height="44"
                             Margin="0,0,14,0"
                             Focusable="False"
                             IsHitTestVisible="False">
                        <Path Fill="#FFFFA83C">
                            <Path.Data>
                                <CombinedGeometry GeometryCombineMode="Exclude">
                                    <CombinedGeometry.Geometry1>
                                        <EllipseGeometry Center="16,16" RadiusX="13" RadiusY="13" />
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <EllipseGeometry Center="22,11" RadiusX="13" RadiusY="13" />
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </Path.Data>
                        </Path>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Night Ember" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Warm, comfortable light after dark"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <DockPanel>
                        <Label x:Name="StrengthLabel" Content="Stren_gth" Target="{Binding ElementName=StrengthSlider}"
                               Padding="0" FontWeight="SemiBold" />
                        <TextBlock x:Name="StrengthValueText" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="Controls how warm the display looks. Higher values reduce more blue light."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <Slider x:Name="StrengthSlider"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="PreviewSlider_ValueChanged"
                            AutomationProperties.LabeledBy="{Binding ElementName=StrengthLabel}"
                            AutomationProperties.AcceleratorKey="Alt+G"
                            AutomationProperties.HelpText="Controls how warm the display looks. Higher values reduce more blue light."
                            Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <DockPanel>
                        <Label x:Name="BrightnessLabel" Content="_Brightness"
                               Target="{Binding ElementName=BrightnessSlider}"
                               Padding="0" FontWeight="SemiBold" />
                        <TextBlock x:Name="BrightnessValueText" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="Darkens the image in software without changing the monitor's backlight."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <Slider x:Name="BrightnessSlider"
                            Minimum="50"
                            Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="PreviewSlider_ValueChanged"
                            AutomationProperties.LabeledBy="{Binding ElementName=BrightnessLabel}"
                            AutomationProperties.AcceleratorKey="Alt+B"
                            AutomationProperties.HelpText="Darkens the image in software without changing the monitor's backlight."
                            Margin="0,8,0,0" />
                </StackPanel>

                <GroupBox Grid.Row="3" Header="Schedule" Padding="0" Margin="0,0,0,18">
                    <GroupBox.Resources>
                    </GroupBox.Resources>
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="{DynamicResource ControlContentThemeFontSize}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <StackPanel KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    PreviewKeyDown="ScheduleOptions_PreviewKeyDown">
                            <RadioButton x:Name="ManualModeRadio"
                                         Content="_Never (manual only)"
                                         IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                         GroupName="Schedule"
                                         Checked="ScheduleMode_Checked"
                                         Margin="0,0,0,4" />
                            <RadioButton x:Name="SunsetModeRadio"
                                         Content="S_unset to sunrise"
                                         IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                         GroupName="Schedule"
                                         Checked="ScheduleMode_Checked"
                                         Margin="0,0,0,4" />
                            <TextBlock x:Name="SunInfoText"
                                       Margin="22,0,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <RadioButton x:Name="CustomModeRadio"
                                         Content="Set _hours"
                                         IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                         GroupName="Schedule"
                                         Checked="ScheduleMode_Checked"
                                         Margin="0,0,0,8" />
                        </StackPanel>
                        <Grid x:Name="CustomTimePanel" Margin="22,0,0,0"
                              TextBoxBase.TextChanged="ScheduleTimes_TextChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Label x:Name="CustomOnLabel"
                                   Grid.Column="0"
                                   Content="Turn _on"
                                   Target="{Binding ElementName=CustomOnInput}"
                                   Padding="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                            <controls:TimeUpDown x:Name="CustomOnInput"
                                                 Grid.Column="1"
                                                 MinuteIncrement="5"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=CustomOnLabel}"
                                                 AutomationProperties.AcceleratorKey="Alt+O"
                                                 AutomationProperties.HelpText="Turn-on time. Type a time or use Left and Right to select hours, minutes, or AM/PM, then Up and Down to adjust. Enter commits the edit; Escape restores it." />
                            <Label x:Name="CustomOffLabel"
                                   Grid.Column="3"
                                   Content="Turn o_ff"
                                   Target="{Binding ElementName=CustomOffInput}"
                                   Padding="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                            <controls:TimeUpDown x:Name="CustomOffInput"
                                                 Grid.Column="4"
                                                 MinuteIncrement="5"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=CustomOffLabel}"
                                                 AutomationProperties.AcceleratorKey="Alt+F"
                                                 AutomationProperties.HelpText="Turn-off time. Type a time or use Left and Right to select hours, minutes, or AM/PM, then Up and Down to adjust. Enter commits the edit; Escape restores it." />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5"
                                        Visibility="{Binding IsChecked, ElementName=CustomModeRadio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock x:Name="CustomOnErrorText"
                                           Style="{StaticResource InputErrorTextStyle}"
                                           Text="{Binding Path=(controls:InputValidation.ErrorMessage), ElementName=CustomOnInput, StringFormat='Turn on: {0}'}"
                                           Visibility="{Binding Path=(controls:InputValidation.HasError), ElementName=CustomOnInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock x:Name="CustomOffErrorText"
                                           Style="{StaticResource InputErrorTextStyle}"
                                           Text="{Binding Path=(controls:InputValidation.ErrorMessage), ElementName=CustomOffInput, StringFormat='Turn off: {0}'}"
                                           Visibility="{Binding Path=(controls:InputValidation.HasError), ElementName=CustomOffInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock x:Name="ScheduleErrorText"
                                           Text=""
                                           AutomationProperties.LiveSetting="Assertive"
                                           Style="{StaticResource InputErrorTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label x:Name="FadeDurationLabel"
                           Content="_Transition duration (0 to 5000 ms)"
                           Target="{Binding ElementName=FadeDurationInput}"
                           Padding="0"
                           VerticalAlignment="Center" />
                    <controls:NumericUpDown x:Name="FadeDurationInput"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="5000"
                                            Increment="50"
                                            AutomationProperties.LabeledBy="{Binding ElementName=FadeDurationLabel}"
                                            AutomationProperties.AcceleratorKey="Alt+T"
                                            AutomationProperties.HelpText="Transition duration, from 0 to 5000 milliseconds. Type a value or use Up and Down to adjust by 50 milliseconds. Enter commits the edit; Escape restores it."
                                            VerticalAlignment="Center" />
                    <TextBlock x:Name="FadeDurationErrorText"
                               Grid.Row="1" Grid.ColumnSpan="2"
                               Style="{StaticResource InputErrorTextStyle}"
                               Text="{Binding Path=(controls:InputValidation.ErrorMessage), ElementName=FadeDurationInput}" />
                    <CheckBox x:Name="StartupCheckBox"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Content="Start _automatically when I sign in"
                              Margin="0,16,0,0" />
                </Grid>

            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="28,12,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Warmth and brightness preview immediately. Save to keep your changes."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button IsCancel="True" Click="CancelButton_Click" Margin="0,0,10,0">
                    <AccessText Text="_Cancel" />
                </Button>
                <Button x:Name="SaveButton" IsDefault="True" Click="SaveButton_Click"
                        Style="{DynamicResource AccentButtonStyle}" Padding="18,7" MinWidth="82">
                    <AccessText Text="_Save" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
