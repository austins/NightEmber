<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishSingleFile>true</PublishSingleFile>
        <AssemblyTitle>Night Ember</AssemblyTitle>
        <Product>Night Ember</Product>
        <Copyright>Austin S.</Copyright>
        <Description>A portable night-light application for Windows.</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
        <StartupObject>NightEmber.Program</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.2.0"/>
        <PackageReference Include="Avalonia.HarfBuzz" Version="12.2.0"/>
        <PackageReference Include="Avalonia.Skia" Version="12.2.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent2" Version="12.2.0"/>
        <PackageReference Include="Avalonia.Win32" Version="12.2.0"/>
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="11.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NightEmber.Core\NightEmber.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests.Unit"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\AppIcon.ico"/>
    </ItemGroup>
</Project>
