<UserControl x:Class="NightEmber.Controls.TimeUpDown"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="100"
             Height="28"
             Focusable="False"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="Once"
             PreviewMouseWheel="TimeUpDown_PreviewMouseWheel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SpinnerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource SpinnerBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Style="{StaticResource SpinnerTextBoxStyle}"
                     AutomationProperties.LabeledBy="{Binding Path=(AutomationProperties.LabeledBy), ElementName=Root}"
                     AutomationProperties.AcceleratorKey="{Binding Path=(AutomationProperties.AcceleratorKey), ElementName=Root}"
                     AutomationProperties.HelpText="{Binding Path=(AutomationProperties.HelpText), ElementName=Root}"
                     TextChanged="ValueTextBox_TextChanged"
                     GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                     PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                     PreviewMouseLeftButtonUp="ValueTextBox_PreviewMouseLeftButtonUp"
                     LostKeyboardFocus="ValueTextBox_LostKeyboardFocus" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <RepeatButton Grid.Row="0"
                              Style="{StaticResource SpinnerButtonStyle}"
                              Click="IncreaseButton_Click"
                              AutomationProperties.Name="Increase selected time part"
                              ToolTip="Increase selected time part">
                    <Path Data="M 2 5 L 6 1 L 10 5 Z"
                          Style="{StaticResource SpinnerArrowStyle}" />
                </RepeatButton>

                <RepeatButton Grid.Row="1"
                              Style="{StaticResource SpinnerButtonStyle}"
                              Click="DecreaseButton_Click"
                              AutomationProperties.Name="Decrease selected time part"
                              ToolTip="Decrease selected time part">
                    <Path Data="M 2 1 L 6 5 L 10 1 Z"
                          Style="{StaticResource SpinnerArrowStyle}" />
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
