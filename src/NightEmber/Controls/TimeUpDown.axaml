<UserControl x:Class="NightEmber.Controls.TimeUpDown"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="100"
             Focusable="True"
             IsTabStop="False">
    <UserControl.Styles>
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name" Value="Increase" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name" Value="Decrease" />
        </Style>
    </UserControl.Styles>
    <ButtonSpinner x:Name="Spinner"
                   IsTabStop="False"
                   Padding="0"
                   MinWidth="0"
                   HorizontalContentAlignment="Stretch"
                   VerticalContentAlignment="Stretch"
                   Spin="Spinner_Spin">
        <TextBox x:Name="ValueTextBox"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 Margin="-1"
                 MinWidth="0"
                 Padding="4,0"
                 AcceptsReturn="False"
                 TextWrapping="NoWrap" />
    </ButtonSpinner>
</UserControl>
