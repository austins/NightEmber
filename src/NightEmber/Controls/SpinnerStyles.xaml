<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PresentationFramework.Fluent;component/Styles/RepeatButton.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="SpinnerBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpinnerButtonStyle"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource DefaultRepeatButtonStyle}">
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="70" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SpinnerArrowStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="4" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
