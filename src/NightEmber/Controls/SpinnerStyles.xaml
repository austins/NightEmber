<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NightEmber.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PresentationFramework.Fluent;component/Styles/RepeatButton.xaml" />
        <ResourceDictionary Source="/PresentationFramework.Fluent;component/Styles/TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="SpinnerBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="0" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition
                        Binding="{Binding Path=(controls:InputValidation.HasError), RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="0" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpinnerTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="5,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpinnerButtonStyle"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource DefaultRepeatButtonStyle}">
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="70" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SpinnerArrowStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="4" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
